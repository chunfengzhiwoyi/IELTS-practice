  {
    "id": "oer-writing-format",
    "type": "official_exam_rule",
    "title": "IELTS Academic Writing Test 考试结构",
    "content": {
      "scope": "Academic Writing Test Format",
      "rules": [
        "写作考试共 60 分钟，包含 Task 1 和 Task 2",
        "Task 1（建议 20 分钟）：描述图表、流程或地图，至少 150 词",
        "Task 2（建议 40 分钟）：针对观点或问题写一篇议论文，至少 250 词",
        "Task 2 分值权重高于 Task 1"
      ],
      "skills": ["writing"],
      "sections": ["Task 1", "Task 2"]
    },
    "provenance": {
      "sourceType": "official",
      "sourceTitle": "IELTS Academic Writing test format",
      "sourceId": "https://www.ielts.org/about-ielts/how-ielts-works/test-format",
      "retrievedAt": "2026-08-09"
    },
    "tags": ["writing", "format", "structure", "academic"]
  },
  {
    "id": "oer-writing-ta",
    "type": "official_exam_rule",
    "title": "Writing: Task Achievement / Task Response 评分标准",
    "content": {
      "scope": "Writing Band Descriptors — Task Achievement (T1) / Task Response (T2)",
      "rules": [
        "Task 1：评估是否充分描述了所有关键特征和趋势",
        "Task 2：评估是否充分回应了题目所有部分，立场是否清晰",
        "高分：完整回应题目要求，观点充分展开且有支撑",
        "低分：偏题、遗漏题目要求、观点不充分或缺乏支撑"
      ],
      "skills": ["writing"],
      "sections": ["Task 1", "Task 2"]
    },
    "provenance": {
      "sourceType": "official",
      "sourceTitle": "IELTS Writing Band Descriptors (public version)",
      "sourceId": "https://www.ielts.org/for-researchers/band-descriptors",
      "retrievedAt": "2026-08-09",
      "sourceLocator": "Task Achievement / Task Response"
    },
    "tags": ["writing", "task-response", "assessment"]
