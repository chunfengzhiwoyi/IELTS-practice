  {
    "id": "oer-speaking-pron",
    "type": "official_exam_rule",
    "title": "Speaking: Pronunciation 评分标准",
    "content": {
      "scope": "Speaking Band Descriptors — Pronunciation",
      "rules": [
        "评估可理解度（intelligibility）",
        "评估语调、重音和节奏的自然度",
        "高分：发音清晰自然，第一语言口音对可理解度影响极小",
        "低分：发音频繁导致误解，缺乏自然语调变化"
      ],
