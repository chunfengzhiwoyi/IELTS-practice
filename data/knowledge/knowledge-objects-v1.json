[
  {
    "id": "oer-speaking-format",
    "type": "official_exam_rule",
    "title": "IELTS Speaking Test 考试结构",
    "content": {
      "scope": "Speaking Test Format",
      "rules": [
        "口语考试共 11-14 分钟，分为三个 Part",
        "Part 1（4-5 分钟）：考官就日常话题提问，考生简要作答",
        "Part 2（3-4 分钟）：考生根据话题卡独白 1-2 分钟，考官可追问",
        "Part 3（4-5 分钟）：考官就 Part 2 话题延伸提出抽象问题，考生展开讨论"
      ],
      "skills": ["speaking"],
      "sections": ["Part 1", "Part 2", "Part 3"]
    },
    "provenance": {
      "sourceType": "official",
      "sourceTitle": "IELTS Speaking test format",
      "sourceId": "https://www.ielts.org/about-ielts/how-ielts-works/test-format",
      "retrievedAt": "2026-08-09"
    },
    "tags": ["speaking", "format", "structure"]
  },
  {
    "id": "oer-speaking-fc",
    "type": "official_exam_rule",
    "title": "Speaking: Fluency and Coherence 评分标准",
    "content": {
      "scope": "Speaking Band Descriptors — Fluency and Coherence",
      "rules": [
        "评估语速的稳定性和自然停顿",
        "评估话语的逻辑连接和推进（discourse markers、connectives）",
        "高分：语速稳定，极少自我修正或犹豫；话语连贯自如",
        "低分：频繁停顿、重复、自我修正；缺乏连接手段"
      ],
      "skills": ["speaking"],
      "sections": ["Part 1", "Part 2", "Part 3"]
    },
    "provenance": {
      "sourceType": "official",
      "sourceTitle": "IELTS Speaking Band Descriptors (public version)",
      "sourceId": "https://www.ielts.org/for-researchers/band-descriptors",
      "retrievedAt": "2026-08-09",
      "sourceLocator": "Fluency and Coherence"
    },
    "tags": ["speaking", "fluency-coherence", "assessment"]
  },
  {
    "id": "oer-speaking-lr",
    "type": "official_exam_rule",
    "title": "Speaking: Lexical Resource 评分标准",
    "content": {
      "scope": "Speaking Band Descriptors — Lexical Resource",
      "rules": [
        "评估考生使用词汇的范围、准确性和灵活性",
        "高分要求：能够使用不常见词汇（less common vocabulary）并展示对搭配的意识",
        "高分要求：能够有效使用 paraphrase 避免重复",
        "低分特征：词汇量有限，频繁重复，搭配不当"
      ],
      "skills": ["speaking"],
      "sections": ["Part 1", "Part 2", "Part 3"]
    },
    "provenance": {
      "sourceType": "official",
      "sourceTitle": "IELTS Speaking Band Descriptors (public version)",
      "sourceId": "https://www.ielts.org/for-researchers/band-descriptors",
      "retrievedAt": "2026-08-09",
      "sourceLocator": "Lexical Resource"
    },
    "tags": ["speaking", "lexical-resource", "assessment"]
  },
  {
    "id": "oer-speaking-gra",
    "type": "official_exam_rule",
    "title": "Speaking: Grammatical Range and Accuracy 评分标准",
    "content": {
      "scope": "Speaking Band Descriptors — Grammatical Range and Accuracy",
      "rules": [
        "评估句式结构的多样性和复杂性",
        "评估语法错误的频率及其对理解的影响",
        "高分：灵活使用复杂结构，错误极少且不影响理解",
        "低分：仅使用简单句式，频繁出现基础语法错误"
      ],
      "skills": ["speaking"],
      "sections": ["Part 1", "Part 2", "Part 3"]
    },
