# =============================================================
# 英语高效学习助手 MVP 0.1 - 环境变量模板
# ------------------------------------------------------------
# 复制此文件为 .env.local 并填入真实值。切勿将 .env.local 提交到仓库。
# .env / .env.local / .env.*.local 均已在 .gitignore 与 .kiroignore 中忽略。
#
# 注意：以 NEXT_PUBLIC_ 开头的变量会被打包进浏览器 bundle。
# 所有 Provider 的 API Key 都不允许使用 NEXT_PUBLIC_ 前缀。
# =============================================================

# =========================================================================
# Data & Auth Mode（P1 新增）
# =========================================================================
# 数据存储：memory | supabase
DATA_PROVIDER=memory
# 身份认证：demo | supabase
AUTH_MODE=demo
# demo 模式下注入的固定用户 ID
DEMO_USER_ID=demo-user-001

# =========================================================================
# LLM Provider 路由（P0.5 新增）
# =========================================================================
# 主 Provider。取值：mock | bailian | deepseek
LLM_PRIMARY_PROVIDER=mock
# 备用 Provider（可选）。仅在 LLM_FALLBACK_ENABLED=true 时生效
LLM_FALLBACK_PROVIDER=mock
# 是否启用 Fallback。默认 false
LLM_FALLBACK_ENABLED=false
# 是否允许 mock provider 参与选择。默认 true，便于本地无 Key 开发
LLM_MOCK_ENABLED=true

# --------------- 阿里云百炼（华北2·北京） ---------------
# 从百炼控制台获取 API Key；工作空间 ID 用于替换 BASE_URL 中的 {WorkspaceId}
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_FAST_MODEL=qwen-flash
BAILIAN_MAIN_MODEL=qwen-plus

# --------------- DeepSeek 官方 API ---------------
# 从 https://platform.deepseek.com 获取
# 只允许使用 deepseek-v4-flash / deepseek-v4-pro；旧型号 deepseek-chat / deepseek-reasoner 已弃用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_MAIN_MODEL=deepseek-v4-pro

# =========================================================================
# Supabase
# =========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 客户端密钥：新版为 sb_publishable_...（旧版为 anon JWT eyJ...）。二者皆可，平替。
# 从 Supabase 仪表盘 Settings → API Keys → “Publishable and secret API keys” 复制 Publishable key。
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx
# 服务端专用；绝不能出现在浏览器包里。
# 新版为 sb_secret_...（旧版为 service_role JWT eyJ...），平替。请用行末复制按钮取完整值。
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx
# 密钥保险库主密钥（KEK，仅服务端）。生成：openssl rand -hex 32
# 用于信封加密用户自带的 LLM API Key / ima 凭证；绝不带 NEXT_PUBLIC_ 前缀。
SECRET_ENCRYPTION_KEY=replace-with-64-hex-chars-generated-by-openssl-rand-hex-32

# =========================================================================
# 微信小程序登录（P2 跨端身份，可选）
# =========================================================================
# 仅当小程序端需要 wx.login 桥接时才填写。网页端用邮箱登录，与此无关。
# 从微信小程序后台「开发管理 → 开发设置」获取 AppID 与 AppSecret。
WECHAT_APPID=
WECHAT_SECRET=

# =========================================================================
# App
# =========================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
